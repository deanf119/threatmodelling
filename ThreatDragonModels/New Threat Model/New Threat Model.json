                {
                  "id": "6828c914-f14d-4e93-9729-8b478569d5d8",
                  "title": "Vulnerability scanning",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Information disclosure",
                  "description": "See OWASP Automated Threat #14:\nSystematic enumeration and examination in order to find weaknesses and points where a security vulnerability might exist\n\nPersonal explanation: as it is connected to account authentication, the public facing part can be considered an attack surface, hence medium severity.",
                  "mitigation": "Defence includes providing anti-automation\n\nPersonal explanation: It is possible to build anti-automation to prevent threat actors from using automation to enumerate and examine weaknesses.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 25,
                  "score": ""
                },
                {
                  "id": "381fcd6a-a425-40c2-a3cc-dded421671db",
                  "title": "Denial of Service",
                  "status": "Open",
                  "severity": "High",
                  "type": "Elevation of privilege",
                  "description": "See OWASP Automated Threat #15:\nUsage may resemble legitimate application usage but leads to exhaustion of resources\n\nPersonal explanation: Denial of Service attack is very common and can be used on a surface that is public facing like the Web service hence the high severity.",
                  "mitigation": "Mitigation or prevention such as providing backoff, resource management and avoiding forced deadlock\n\nPersonal explanation: having multiple backoff options reduce the risk of a successful DOS Attack.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 26,
                  "score": ""
